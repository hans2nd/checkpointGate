<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing files directly (e.g. index.php itself on rewrite loop)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Static assets: serve from public/ directory
    RewriteRule ^(build|storage|images|css|js|fonts)(/.*)?$ public/$1$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Route all other requests to root index.php (Laravel entry point)
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes
